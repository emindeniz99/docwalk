{
  "name": "docwalk",
  "version": "0.0.0",
  "private": true,
  "description": "Walk a team through a GitHub Markdown + Mermaid design doc: slides from its headings, explorable diagrams, honest overflow.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.browser.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test:all && pnpm build"
  },
  "dependencies": {
    "@panzoom/panzoom": "4.6.2",
    "dompurify": "3.4.17",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "reveal.js": "6.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "fast-check": "4.10.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.16.1"
}

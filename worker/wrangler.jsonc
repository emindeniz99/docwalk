// docwalk full mode (decisions 24, 37, 38). See worker/README.md.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "docwalk",
  "main": "./index.ts",
  "compatibility_date": "2026-10-01",
  // The static build from `pnpm build`. Only /api/* runs the Worker first; every
  // other path is served straight from the assets, with headers from dist/_headers.
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // One Durable Object per remote-control room. Delete this block and the
  // migration to self-host without remote control: /api/health then omits "remote".
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RemoteRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RemoteRoom"] }],
  "vars": {
    // Empty: the app is served from this Worker, so the request's own origin is the
    // app origin. Set it (e.g. "https://docwalk.example") to pin a custom domain.
    "APP_ORIGIN": "",
  },
  // Secrets, never in this file: `wrangler secret put GITHUB_CLIENT_ID` and
  // `wrangler secret put GITHUB_CLIENT_SECRET`. Without both, "oauth" is not offered.
  // No logs, traces or analytics (decision 12), and no Wrangler usage metrics.
  "observability": { "enabled": false },
  "send_metrics": false,
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["fcTest.prop"] }],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@fontsource-variable/*", "monaco-editor/features/*/register"]
      }
    ]
  },
  "ignorePatterns": ["dist/**", "fixtures/**", "src/paraglide/**"]
}

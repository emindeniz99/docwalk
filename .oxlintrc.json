{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["fcTest.prop"] }],
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": ["dist/**", "fixtures/**"]
}
